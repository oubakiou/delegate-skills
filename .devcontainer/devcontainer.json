{
  "name": "delegate-skills devcontainer",
  // https://hub.docker.com/r/microsoft/devcontainers-base
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // https://github.com/devcontainers/features/tree/main/src/node
    "ghcr.io/devcontainers/features/node:1": {
      "version": "latest"
    },
    // https://github.com/devcontainers/features/tree/main/src/github-cli
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.90.0"
    }
  },
  "privileged": false,
  "init": true,
  "remoteUser": "vscode",
  "runArgs": ["--name", "${localEnv:USER}-delegate-skills"],
  "postCreateCommand": "./local_setup.sh",
  // 掃除の失敗・script 不在で container 起動をブロックしない
  "postStartCommand": "bash -lc 'cleanup_status=0; bash scripts/clean-devcontainer-disk.sh --threshold 90 || cleanup_status=$?; if [ \"$cleanup_status\" -ne 0 ]; then printf \"warning: devcontainer disk cleanup failed (exit %s); continuing startup\\n\" \"$cleanup_status\" >&2; fi'",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        }
      }
    }
  }
}
